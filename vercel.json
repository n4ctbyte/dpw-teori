{
  "version": 2,
  "builds": [
    {
      "src": "undangan-nikah/api/index.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "undangan-nikah/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/undangan-nikah/public/build/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/undangan-nikah/public/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/undangan-nikah/api/index.php"
    }
  ]
}